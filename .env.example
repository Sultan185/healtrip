APP_NAME=HealTrip
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- HealTrip agent -----------------------------------------------------
# Keys are read on the server only and are never sent to the browser.
# A provider is offered in the UI once it has a model and (if it needs one)
# a key. Configure one or several; each conversation stays on the provider
# it started with.

# The provider new conversations use: anthropic | openai | gemini | ollama
LLM_PROVIDER=anthropic

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
# Thinking depth vs. latency: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Retry on a fallback model if the primary model's safety classifiers decline a request.
# Set to false for models that have no fallback configuration.
ANTHROPIC_REFUSAL_FALLBACK=true

# OpenAI. Set the model ID you want to use, from your OpenAI dashboard.
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini, through its OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=

# A local Ollama server. Needs no key; set a model you have pulled that
# supports tool calling.
OLLAMA_MODEL=

# Abuse / spend limits per client IP
HEALTRIP_MESSAGES_PER_MINUTE=10
HEALTRIP_MESSAGES_PER_DAY=150
